<?xml version="1.0"?>
<launch>
  <arg name="config" default="$(find-pkg-share sand_rake_control)/config/small_vehicle.yaml"/>
  <node pkg="sand_rake_control" exec="safety_controller" name="safety_controller" output="screen">
    <param from="$(var config)"/>
  </node>
  <node pkg="sand_rake_control" exec="chassis_controller_node" name="chassis_controller" output="screen">
    <param from="$(var config)"/>
  </node>
  <node pkg="sand_rake_control" exec="chassis_mock_node" name="chassis_mock" output="screen">
    <param from="$(var config)"/>
  </node>
</launch>
